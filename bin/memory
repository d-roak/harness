#!/usr/bin/env sh
# File-based memory shared by every agent tool. One fact per file, an index per scope.
#   ~/.agents/memory/global/           facts about the user and their preferences
#   ~/.agents/memory/repos/<name>/     facts about one repo (lessons, traps, decisions)
# Never inside a repo: memory is personal and must not end up in a commit.
#
#   memory add <type> <slug> "<one-line description>" [--repo]   body from stdin
#   memory list [--repo]
#   memory show <slug> [--repo]
#   memory search <term>
#   memory rm <slug> [--repo]
#   memory context            index of global + current repo, for session start
set -eu

ROOT="${HARNESS_MEMORY_DIR:-$HOME/.agents/memory}"
TYPES="user feedback project reference"

repo_name() {
	common="$(git rev-parse --git-common-dir 2>/dev/null || true)"
	[ -n "$common" ] || return 0
	common="$(cd "$common" && pwd)"
	basename "$(dirname "$common")"
}

valid_slug() {
	echo "$1" | grep -Eq '^[a-z0-9][a-z0-9-]*$'
}

scope_dir() {
	if [ "${1:-}" = "--repo" ]; then
		r="$(repo_name)"
		[ -n "$r" ] || { echo "memory: not inside a git repo, --repo has no target" >&2; exit 1; }
		echo "$ROOT/repos/$r"
	else
		echo "$ROOT/global"
	fi
}

reindex() {
	dir="$1"; idx="$dir/MEMORY.md"
	mkdir -p "$dir"
	: > "$idx"
	for f in "$dir"/*.md; do
		[ "$f" = "$idx" ] && continue
		[ -f "$f" ] || continue
		name="$(sed -n 's/^name: //p' "$f" | head -1)"
		desc="$(sed -n 's/^description: //p' "$f" | head -1)"
		echo "- [$name]($(basename "$f")) — $desc" >> "$idx"
	done
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
add)
	type="${1:?type}"; slug="${2:?slug}"; desc="${3:?description}"; scope="${4:-}"
	case " $TYPES " in *" $type "*) ;; *) echo "memory: type must be one of: $TYPES" >&2; exit 1;; esac
	valid_slug "$slug" || { echo "memory: slug must be kebab-case" >&2; exit 1; }
	printf '%s' "$desc" | grep -Eq '^[^[:cntrl:]:#]+$' || { echo "memory: description must be one line without : or #" >&2; exit 1; }
	dir="$(scope_dir "$scope")"; mkdir -p "$dir"
	body="$(cat)"
	printf -- '---\nname: %s\ndescription: %s\ntype: %s\ncreated: %s\n---\n\n%s\n' \
		"$slug" "$desc" "$type" "$(date +%F)" "$body" > "$dir/$slug.md"
	reindex "$dir"; echo "$dir/$slug.md" ;;
list)
	dir="$(scope_dir "${1:-}")"; [ -f "$dir/MEMORY.md" ] && cat "$dir/MEMORY.md" || true ;;
show)
	slug="${1:?slug}"; valid_slug "$slug" || { echo "memory: slug must be kebab-case" >&2; exit 1; }
	dir="$(scope_dir "${2:-}")"; cat "$dir/$slug.md" ;;
search)
	term="${1:?term}"; [ -d "$ROOT" ] && grep -ril -- "$term" "$ROOT" --include='*.md' --exclude=MEMORY.md || true ;;
rm)
	slug="${1:?slug}"; valid_slug "$slug" || { echo "memory: slug must be kebab-case" >&2; exit 1; }
	dir="$(scope_dir "${2:-}")"; rm -f "$dir/$slug.md"; reindex "$dir" ;;
context)
	if [ -s "$ROOT/global/MEMORY.md" ]; then echo "## memory: global"; cat "$ROOT/global/MEMORY.md"; fi
	r="$(repo_name)"
	if [ -n "$r" ] && [ -s "$ROOT/repos/$r/MEMORY.md" ]; then echo; echo "## memory: $r"; cat "$ROOT/repos/$r/MEMORY.md"; fi ;;
*)
	sed -n '2,12p' "$0"; exit 1 ;;
esac
